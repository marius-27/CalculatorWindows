<Window x:Class="CalculatorWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CalculatorWindows"
        mc:Ignorable="d"
        Title="Calculator" Height="600" Width="500" ResizeMode="NoResize">

    <!-- Resurse pentru stilizarea meniului contextual -->
    <Window.Resources>
        <Style TargetType="ContextMenu">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <!-- Layout-ul principal al ferestrei -->
    <DockPanel>
        <!-- Meniul principal -->
        <Menu DockPanel.Dock="Top">
            <!-- Butonul File -->
            <MenuItem Header="File">
                <MenuItem Header="Copy" Click="Copy_Click"/>
                <MenuItem Header="Cut" Click="Cut_Click"/>
                <MenuItem Header="Paste" Click="Paste_Click"/>
                <Separator/>
                <!-- Linie de separare -->
                <MenuItem Header="Data Grouping" Click="DataGrouping_Click"/>
                <MenuItem Header="Cascade Operation" Click="CascadeOperation_Click"/>
            </MenuItem>

            <!-- Butonul Help -->
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Continutul principal al ferestrei (calculatorul) -->
        <Grid Margin="5,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Selector Mod -->
                <RowDefinition Height="Auto"/>
                <!-- Afișaj -->
                <RowDefinition Height="Auto"/>
                <!-- Butoane memorie -->
                <RowDefinition Height="Auto"/>
                <!-- %, CE, C, ⌫ -->
                <RowDefinition Height="Auto"/>
                <!-- 1/x, x², √x, ÷ -->
                <RowDefinition Height="Auto"/>
                <!-- 7, 8, 9, × -->
                <RowDefinition Height="Auto"/>
                <!-- 4, 5, 6, - -->
                <RowDefinition Height="Auto"/>
                <!-- 1, 2, 3, + -->
                <RowDefinition Height="Auto"/>
                <!-- ±, 0, ., = -->
            </Grid.RowDefinitions>

            <!-- 🔹 Selector Mod (Standard / Programmer) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,5,0,5">
                <ComboBox x:Name="ModeSelector" SelectionChanged="ModeSelector_SelectionChanged"
                          Width="50" Height="30" Background="Transparent" BorderThickness="0">
                    <ComboBoxItem Content="Standard"/>
                    <ComboBoxItem Content="Programmer"/>
                </ComboBox>

                <TextBlock x:Name="CurrentMode" Text="Standard" FontSize="16"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- 🔹 Afisaj calculator -->
            <TextBox x:Name="DisplayText"
         Text="0"
         FontSize="48"
         FontWeight="Bold"
         VerticalAlignment="Top"
         TextAlignment="Right"
         IsReadOnly="True"
         BorderThickness="0"
         Background="Transparent"
         Padding="10"
         Margin="10,10,10,5"
         Height="73" Grid.Row="1">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="Copy_Click"/>
                        <MenuItem Header="Cut" Click="Cut_Click"/>
                        <MenuItem Header="Paste" Click="Paste_Click"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

            <!-- Butoanele de memorie -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Width" Value="80"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" 
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10" Padding="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <Button Content="MC" Click="MemoryClear_Click"/>
                <Button Content="MR" Click="MemoryRecall_Click"/>
                <Button Content="M+" Click="MemoryAdd_Click"/>
                <Button Content="M-" Click="MemorySubtract_Click"/>
                <Button Content="MS" Click="MemoryStore_Click"/>

                <!-- Buton pentru vizualizarea memoriei -->
                <Button Click="ShowMemory_Click" Width="70">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="M" FontSize="16"/>
                        <TextBlock Text="▾" FontSize="16" Margin="3,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  %, CE, C, ⌫ -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button Content="%" Click="Percent_Click"/>
                <Button Content="CE" Click="ClearEntry_Click"/>
                <Button Content="C" Click="Clear_Click"/>
                <Button Content="⌫" Click="Backspace_Click"/>
            </StackPanel>

            <!--  1/x, x², √x, ÷ -->
            <!--  1/x, x², √x, ÷ -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button x:Name="ButtonReciprocal" Content="1/x" Click="Reciprocal_Click"/>
                <Button x:Name="ButtonSquare" Content="x²" Click="Square_Click"/>
                <Button x:Name="ButtonSquareRoot" Content="√x" Click="SquareRoot_Click"/>
                <Button x:Name="ButtonDivide" Content="÷" Click="Operator_Click"/>
            </StackPanel>

            <!--  7, 8, 9, × -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button x:Name="Button7" Content="7" Click="Number_Click"/>
                <Button x:Name="Button8" Content="8" Click="Number_Click"/>
                <Button x:Name="Button9" Content="9" Click="Number_Click"/>
                <Button x:Name="ButtonMultiply" Content="×" Click="Operator_Click"/>
            </StackPanel>

            <!--  4, 5, 6, - -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button x:Name="Button4" Content="4" Click="Number_Click"/>
                <Button x:Name="Button5" Content="5" Click="Number_Click"/>
                <Button x:Name="Button6" Content="6" Click="Number_Click"/>
                <Button x:Name="ButtonSubtract" Content="-" Click="Operator_Click"/>
            </StackPanel>

            <!--  1, 2, 3, + -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button x:Name="Button1" Content="1" Click="Number_Click"/>
                <Button x:Name="Button2" Content="2" Click="Number_Click"/>
                <Button x:Name="Button3" Content="3" Click="Number_Click"/>
                <Button x:Name="ButtonAdd" Content="+" Click="Operator_Click"/>
            </StackPanel>

            <!--  ±, 0, ., = -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button x:Name="ButtonNegate" Content="±" Click="Negate_Click"/>
                <Button x:Name="Button0" Content="0" Click="Number_Click"/>
                <Button x:Name="ButtonDecimal" Content="." Click="Decimal_Click"/>
                <Button x:Name="ButtonEquals" Content="=" Click="Equals_Click" Background="#007ACC" Foreground="White"/>
            </StackPanel>

            <!--  ±, 0, ., = -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,5">
                <Button Content="±" Click="Negate_Click"/>
                <Button Content="0" Click="Number_Click"/>
                <Button Content="." Click="Decimal_Click"/>
                <Button Content="=" Click="Equals_Click" Background="#007ACC" Foreground="White"/>
            </StackPanel>

            <!-- Stil general pentru toate butoanele -->
            <Grid.Resources>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="BorderBrush" Value="Gray"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="2"/>
                    <Setter Property="Width" Value="100"/>
                    <Setter Property="Height" Value="40"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="10" Padding="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>
        </Grid>
    </DockPanel>
</Window>